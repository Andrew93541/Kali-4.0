<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/kali_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="40dp"
        android:paddingBottom="32dp">

        <!-- Brand Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="K A L I"
            android:textColor="@color/kali_pink"
            android:textSize="36sp"
            android:textStyle="bold"
            android:letterSpacing="0.3"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WOMEN'S SAFETY SYSTEM"
            android:textColor="#88FFFFFF"
            android:textSize="10sp"
            android:letterSpacing="0.25"
            android:layout_marginBottom="32dp" />

        <!-- Section Title Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_glass"
            android:padding="24dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CREATE ACCOUNT"
                android:textColor="#59557D"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="20dp" />

            <!-- Full Name Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:boxBackgroundColor="@color/kali_surface"
                app:boxStrokeColor="@color/kali_pink"
                app:hintTextColor="@color/kali_pink"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Full Name"
                    android:inputType="textPersonName"
                    android:textColor="@color/kali_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone Number Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:boxBackgroundColor="@color/kali_surface"
                app:boxStrokeColor="@color/kali_pink"
                app:hintTextColor="@color/kali_pink"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Phone Number"
                    android:inputType="phone"
                    android:textColor="@color/kali_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:boxBackgroundColor="@color/kali_surface"
                app:boxStrokeColor="@color/kali_pink"
                app:hintTextColor="@color/kali_pink"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email Address"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/kali_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                app:boxBackgroundColor="@color/kali_surface"
                app:boxStrokeColor="@color/kali_pink"
                app:hintTextColor="@color/kali_pink"
                app:passwordToggleEnabled="true"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Password (min 6 chars)"
                    android:inputType="textPassword"
                    android:textColor="@color/kali_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Role Selection Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT ROLE"
                android:textColor="#59557D"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="12dp" />

            <!-- Role Chip Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipUser"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="User"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/kali_pink"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipGuardian"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:text="Guardian"
                    android:textSize="12sp"
                    android:textColor="#88FFFFFF"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="#1E1A33"
                    app:strokeColor="#FF2D8A"
                    app:strokeWidth="1dp"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipPolice"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Police"
                    android:textSize="12sp"
                    android:textColor="#88FFFFFF"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="#1E1A33"
                    app:strokeColor="#FF2D8A"
                    app:strokeWidth="1dp"
                    app:cornerRadius="20dp" />

            </LinearLayout>

            <!-- Selected role display -->
            <TextView
                android:id="@+id/tvSelectedRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Role: User"
                android:textColor="#88FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- Register Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="CREATE ACCOUNT"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:letterSpacing="0.08"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            android:background="@drawable/bg_gradient_button"
            app:cornerRadius="12dp"
            android:layout_marginBottom="20dp" />

        <!-- Navigation link back to Login -->
        <TextView
            android:id="@+id/tvSignInLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? Sign In"
            android:textColor="#88FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
