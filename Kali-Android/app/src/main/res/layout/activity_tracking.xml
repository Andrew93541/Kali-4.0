<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kali_bg">

    <!-- 100% Native Full-Bleed Map View -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Overlay: Status and Control Panel (Glassmorphic) -->
    <LinearLayout
        android:id="@+id/layoutTopCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_glass"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:elevation="6dp">

        <ImageButton
            android:id="@+id/btnExitDashboard"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_demo_badge"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/white"
            android:contentDescription="Exit" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <TextView
                android:id="@+id/tvDashboardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TACTICAL RADAR ACTIVE"
                android:textColor="#FF2D8A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <TextView
                android:id="@+id/tvTargetName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target: Connecting to feed..."
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Status indicator dot -->
        <View
            android:id="@+id/viewStatusLight"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_pulsing_marker"
            android:backgroundTint="@color/kali_green" />

    </LinearLayout>

    <!-- Center Loading Spinner (during initial tiles cache) -->
    <ProgressBar
        android:id="@+id/pbLoading"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerInParent="true"
        android:indeterminateTint="#FF2D8A"
        android:visibility="gone" />

    <!-- Bottom Overlay: Telemetry HUD (Glassmorphic) -->
    <LinearLayout
        android:id="@+id/layoutBottomCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_glass"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:padding="20dp"
        android:elevation="8dp">

        <TextView
            android:text="REAL-TIME TELEMETRY ENGINE (EKF)"
            android:textColor="#88FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- 2x2 Telemetry Aggregation Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false"
            android:layout_marginBottom="20dp">

            <!-- SPEED -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_demo_badge">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VELOCITY"
                    android:textColor="#59557D"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTelemetrySpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0 km/h"
                    android:textColor="#00F2FE"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- ETA -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_demo_badge">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESCUE ETA"
                    android:textColor="#59557D"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTelemetryEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- min"
                    android:textColor="#FF2D8A"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- DISTANCE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_demo_badge">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL DISTANCE"
                    android:textColor="#59557D"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTelemetryDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00 km"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- BEARING -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_demo_badge">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HEADING"
                    android:textColor="#59557D"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTelemetryBearing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- (0°)"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </GridLayout>

        <!-- Command Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnCallTarget"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_demo_badge"
                android:src="@android:drawable/ic_menu_call"
                app:tint="@color/white"
                android:layout_marginEnd="12dp"
                android:contentDescription="Call" />

            <!-- Resolve Emergency Action Button -->
            <Button
                android:id="@+id/btnResolveAlert"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="54dp"
                android:background="@drawable/bg_gradient_button"
                app:backgroundTint="@null"
                android:text="RESOLVE EMERGENCY"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:elevation="2dp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
