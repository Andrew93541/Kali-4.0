<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/kali_bg"
    android:padding="32dp">

    <TextView
        android:text="KALI"
        android:textSize="36sp"
        android:textColor="@color/kali_pink"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="Women\'s Safety App"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="48dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSos"
        android:text="SOS"
        android:textSize="28sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:backgroundTint="@color/kali_pink"
        app:cornerRadius="90dp"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginBottom="32dp"
        android:elevation="8dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:text="Ready"
        android:textSize="16sp"
        android:textColor="@color/kali_text"
        android:layout_marginBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        android:text="Cancel SOS"
        android:enabled="false"
        app:backgroundTint="@color/kali_surface"
        android:textColor="#aaaaaa"
        app:cornerRadius="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</LinearLayout>
