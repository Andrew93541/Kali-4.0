<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/kali_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ── Top Header Row ──────────────────────────────────────────────── -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp">

            <!-- Back button -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_demo_badge"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/white"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SECURE PROFILE"
                android:textColor="@color/kali_pink"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_toEndOf="@id/btnBack"
                android:layout_marginStart="16dp"
                android:layout_centerVertical="true" />

        </RelativeLayout>

        <!-- ── User Profile Card ───────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_glass"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERSONAL INFORMATION"
                android:textColor="#59557D"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp" />

            <!-- Email Display (Read-Only) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL ADDRESS (READ-ONLY)"
                android:textColor="#88FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/kali_text"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@color/kali_bg"
                android:layout_marginBottom="14dp"
                android:text="email@domain.com" />

            <!-- Role Display (Read-Only) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SECURE PROFILE ROLE"
                android:textColor="#88FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#00F2FE"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="12dp"
                android:background="@color/kali_bg"
                android:layout_marginBottom="14dp"
                android:text="User" />

            <!-- Name Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:boxBackgroundColor="@color/kali_surface"
                app:boxStrokeColor="@color/kali_pink"
                app:hintTextColor="@color/kali_pink"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Full Name"
                    android:inputType="textPersonName"
                    android:textColor="@color/kali_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:boxBackgroundColor="@color/kali_surface"
                app:boxStrokeColor="@color/kali_pink"
                app:hintTextColor="@color/kali_pink"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Phone Number"
                    android:inputType="phone"
                    android:textColor="@color/kali_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Update Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateProfile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="UPDATE PROFILE DETAILS"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="12sp"
                app:backgroundTint="@null"
                android:background="@drawable/bg_gradient_button"
                app:cornerRadius="8dp" />

        </LinearLayout>

        <!-- ── Guardian Connection Card ────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/cardGuardian"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_glass"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvGuardianTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GUARDIAN CONTROL LINK"
                android:textColor="#59557D"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp" />

            <!-- Link Status Info -->
            <TextView
                android:id="@+id/tvGuardianStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/kali_text"
                android:textSize="13sp"
                android:layout_marginBottom="14dp"
                android:text="Status: Loading connection..." />

            <!-- Connection Form (if no link) -->
            <LinearLayout
                android:id="@+id/llLinkGuardianForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Link email input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:boxBackgroundColor="@color/kali_surface"
                    app:boxStrokeColor="@color/kali_pink"
                    app:hintTextColor="@color/kali_pink"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGuardianEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Guardian's Email Address"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/kali_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OR"
                    android:textColor="#59557D"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="14dp" />

                <!-- Link phone input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxBackgroundColor="@color/kali_surface"
                    app:boxStrokeColor="@color/kali_pink"
                    app:hintTextColor="@color/kali_pink"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGuardianPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Guardian's Phone Number"
                        android:inputType="phone"
                        android:textColor="@color/kali_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLinkGuardian"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="ESTABLISH GUARDIAN SECURE LINK"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    app:backgroundTint="@color/kali_pink"
                    app:cornerRadius="8dp" />

            </LinearLayout>

            <!-- Unlink Button (if linked) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnlinkGuardian"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="SEVER GUARDIAN LINK (UNLINK)"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="12sp"
                android:visibility="gone"
                app:backgroundTint="@color/kali_red"
                app:cornerRadius="8dp" />

        </LinearLayout>

        <!-- ── Emergency Contacts Card (User Only) ─────────────────────────── -->
        <LinearLayout
            android:id="@+id/cardContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_glass"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MANAGE EMERGENCY CONTACTS"
                android:textColor="#59557D"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp" />

            <!-- Add Contact Fields -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:boxBackgroundColor="@color/kali_surface"
                app:boxStrokeColor="@color/kali_pink"
                app:hintTextColor="@color/kali_pink"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContactName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Contact Name"
                    android:inputType="textPersonName"
                    android:textColor="@color/kali_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:boxBackgroundColor="@color/kali_surface"
                app:boxStrokeColor="@color/kali_pink"
                app:hintTextColor="@color/kali_pink"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContactPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Phone Number"
                    android:inputType="phone"
                    android:textColor="@color/kali_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="@color/kali_surface"
                app:boxStrokeColor="@color/kali_pink"
                app:hintTextColor="@color/kali_pink"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContactRelation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Relationship (e.g. Mother, Father, Friend)"
                    android:inputType="text"
                    android:textColor="@color/kali_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/cbIsPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set as Primary SOS contact"
                android:textColor="@color/kali_text"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddContact"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="ADD EMERGENCY CONTACT"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="12sp"
                app:backgroundTint="@color/kali_pink"
                app:cornerRadius="8dp"
                android:layout_marginBottom="24dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#15FFFFFF"
                android:layout_marginBottom="16dp" />

            <!-- Saved Contacts Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAVED SECURE CONTACTS"
                android:textColor="#59557D"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <!-- Dynamic Contacts Container -->
            <LinearLayout
                android:id="@+id/llContactsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
